# justcoffee environment

# Optional. When set, justcoffee uses Claude to write the "why you two" match
# rationale and to refine ranking. Without it, the app falls back to its built-in
# deterministic matching engine — the full product loop works either way.
ANTHROPIC_API_KEY=

# Optional model override for the Claude rationale path.
JUSTCOFFEE_CLAUDE_MODEL=claude-opus-4-8

# Secret used to sign the lightweight session cookie. Set any random string in prod.
JUSTCOFFEE_SESSION_SECRET=dev-only-change-me
