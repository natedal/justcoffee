# justcoffee environment — copy this file to .env.local and fill in your values.
# NEVER put real secrets in this file. It is committed to git.

# Required in production. Sign any random 40+ char string.
JUSTCOFFEE_SESSION_SECRET=dev-only-change-me

# The public URL of your deployment (used in magic-link emails).
NEXT_PUBLIC_APP_URL=https://justcoffee.app

# Email delivery (Resend). Without this, magic links are shown on screen ("demo mode").
JUSTCOFFEE_EMAIL_FROM=you@yourdomain.app
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic — enables the Claude-written match rationale. Optional; app works without it.
ANTHROPIC_API_KEY=sk-ant-xxxx
JUSTCOFFEE_CLAUDE_MODEL=claude-opus-4-8

# Supabase — replaces the file-backed store for production.
# Get these from: supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Cloudflare R2 — replaces local photo storage for production.
# Get these from: Cloudflare → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=xxxx
R2_ACCESS_KEY_ID=xxxx
R2_SECRET_ACCESS_KEY=xxxx
R2_BUCKET=justcoffee-photos
R2_PUBLIC_URL=https://photos.yourdomain.app

# --- Monitoring (all optional; the app runs identically without them) ---

# PostHog — product analytics / the usage funnel. From: posthog.com → Project
# Settings → API keys. The client key is safe to expose; the same value is used
# server-side for the core-loop events fired from the API routes.
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=phc_xxxx
POSTHOG_HOST=https://us.i.posthog.com

# Sentry — crash & error monitoring. From: sentry.io → your project → Settings.
SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX
# Optional — only needed to upload source maps during the production build:
SENTRY_ORG=your-org
SENTRY_PROJECT=justcoffee
SENTRY_AUTH_TOKEN=sntrys_xxxx
